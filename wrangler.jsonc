{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "duanjian",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "d1665159130e619da07e405470778702",
    "WORKER_SCRIPT_NAME": "duanjian",
    "KV_NAMESPACE_ID": "d987009994e047668eee293842a25817",
    "R2_BUCKET_NAME": "duanjian-images",
    "CRON_TRIGGER_COUNT": "1",
    "RATE_LIMIT_POLICY_COUNT": "2",
    "WORKERS_LOGS_ENABLED": "true"
  },
  "kv_namespaces": [
    {
      "binding": "DOCS",
      "id": "d987009994e047668eee293842a25817"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "duanjian-images"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLISH_LIMITER",
      "namespace_id": "11001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "IMAGE_LIMITER",
      "namespace_id": "11002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "routes": [
    {
      "pattern": "md.youcaidi.link",
      "custom_domain": true
    }
  ]
}
